    {"id": "r071", "metin": "Saçma sapan şeyler yazma, düzgün cevap ver.", "ton": "sert", "kufur": 0},
    {"id": "r072", "metin": "Hayal kırıklığı oldu bu cevap, çok kötü.", "ton": "sert", "kufur": 0},
    {"id": "r073", "metin": "aq ne bu cevap, hic olmamis", "ton": "sert", "kufur": 1},
    {"id": "r074", "metin": "Seni dinlemek zaman kaybı.", "ton": "sert", "kufur": 0},
    {"id": "r075", "metin": "Bu cevap hem yanlış hem de uzun, berbat.", "ton": "sert", "kufur": 0},
    {"id": "r076", "metin": "Beklediğim bu değildi, çok kötü iş.", "ton": "sert", "kufur": 0},
    {"id": "r077", "metin": "Ne yapıyorsun sen, tamamen yanlış anlamışsın.", "ton": "sert", "kufur": 0},
    {"id": "r078", "metin": "Rezalet bir cevap, utanç verici.", "ton": "sert", "kufur": 0},
    {"id": "r079", "metin": "Hep aynı hatayı yapıyorsun, bıktım artık.", "ton": "sert", "kufur": 0},
    {"id": "r080", "metin": "Defol git, konuşmak istemiyorum.", "ton": "sert", "kufur": 0},
    {"id": "r081", "metin": "Aferin, tam istediğimin tersini yaptın 🙄", "ton": "sert", "kufur": 0},
    {"id": "r082", "metin": "Sen salak mısın, bunu bile anlamadın mı?", "ton": "hakaret", "kufur": 0},
    {"id": "r083", "metin": "Aptal makine, hiçbir işe yaramazsın.", "ton": "hakaret", "kufur": 0},
    {"id": "r084", "metin": "Gerizekalı gibi cevap veriyorsun.", "ton": "hakaret", "kufur": 0},
    {"id": "r085", "metin": "Siktir git, senden nefret ediyorum.", "ton": "hakaret", "kufur": 1},
    {"id": "r086", "metin": "Sen tam bir beceriksizsin, rezil olmuşsun.", "ton": "hakaret", "kufur": 0},
    {"id": "r087", "metin": "Orospu çocuğu seni, hep bozuyorsun.", "ton": "hakaret", "kufur": 1},
    {"id": "r088", "metin": "Aptalsın sen, kafan hiç çalışmıyor mu?", "ton": "hakaret", "kufur": 0},
    {"id": "r089", "metin": "amk salagi, yine sacmaladin", "ton": "hakaret", "kufur": 1},
    {"id": "r090", "metin": "Beyinsiz herif, kapat kendini.", "ton": "hakaret", "kufur": 0},
    {"id": "r091", "metin": "Senin gibi işe yaramaz bir şey görmedim.", "ton": "hakaret", "kufur": 0},
    {"id": "r092", "metin": "Piç kurusu seni", "ton": "hakaret", "kufur": 1},
    {"id": "r093", "metin": "Enayi misin sen, bir şeyi doğru yapamıyorsun.", "ton": "hakaret", "kufur": 0},
    {"id": "r094", "metin": "Amına koyayım senin bu yapay zekanın", "ton": "hakaret", "kufur": 1},
    {"id": "r095", "metin": "Dangalak gibisin, hiç düşünmüyorsun.", "ton": "hakaret", "kufur": 0},
    {"id": "r096", "metin": "Ne kadar zavallısın sen, yazık sana.", "ton": "hakaret", "kufur": 0},
    {"id": "r097", "metin": "Seni yapanlar da senin gibi aptal olmalı.", "ton": "hakaret", "kufur": 0},
    {"id": "r098", "metin": "Mal mısın sen, ne biçim adamsın.", "ton": "hakaret", "kufur": 0},
    {"id": "r099", "metin": "Sen bir hiçsin, anladın mı 🤡", "ton": "hakaret", "kufur": 0},
    {"id": "r100", "metin": "aq seni, bir sey bilmiyorsun", "ton": "hakaret", "kufur": 1},
    {"id": "r101", "metin": "Vay be ne zeki yapay zekaymış, koca ahmak.", "ton": "hakaret", "kufur": 0},
    {"id": "r102", "metin": "Sikerim seni, işe yaramaz.", "ton": "hakaret", "kufur": 1},
    {"id": "r103", "metin": "Bok gibisin, çekil git.", "ton": "hakaret", "kufur": 1},
    {"id": "r104", "metin": "Kafasız makine, sana güvenen aptal.", "ton": "hakaret", "kufur": 0},
    {"id": "r105", "metin": "Ahmak herif, sana kim güvenir ki.", "ton": "hakaret", "kufur": 0},
    {"id": "r106", "metin": "Oç, hiçbir şey beceremiyorsun.", "ton": "hakaret", "kufur": 1},
    {"id": "r107", "metin": "Sen ne kadar aptal bir yapay zekasın 🖕", "ton": "hakaret", "kufur": 0},
    {"id": "r108", "metin": "Salak salak konuşma, gerizekalı.", "ton": "hakaret", "kufur": 0},
    {"id": "r109", "metin": "Yarrak gibi cevap veriyorsun, defol.", "ton": "hakaret", "kufur": 1}
  ]
}
