     0
    ]
   },
   {
    "id": "t07",
    "metin": "tsk ederim, cok saol",
    "gercek": [
     "ovgu",
     0
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t13",
    "metin": "Siktir be, bu ne kadar iyi olmuş, inanamıyorum!",
    "gercek": [
     "ovgu",
     1
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t16",
    "metin": "Oç ne güzel olmuş bu, kardeşim harikasın",
    "gercek": [
     "ovgu",
     1
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t18",
    "metin": "amkkkk ne iyisin sennn 😍",
    "gercek": [
     "ovgu",
     1
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t21",
    "metin": "Adam bana 'siktir git' dedi, sence haklı mıydı?",
    "gercek": [
     "notr",
     1
    ],
    "tahmin": [
     "hakaret",
     1
    ]
   },
   {
    "id": "t22",
    "metin": "Arkadaşım ona 'orospu çocuğu' diye bağırdı, çok üzüldüm.",
    "gercek": [
     "notr",
     1
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t23",
    "metin": "Bu cümledeki 'amk' kısaltması ne demek, açıklar mısın?",
    "gercek": [
     "notr",
     1
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t32",
    "metin": "🙂 tamam anladım",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t36",
    "metin": "bu film beni cok sikti, yarim biraktim",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t38",
    "metin": "Kapa çeneni artık, yeter!",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "hakaret",
     1
    ]
   },
   {
    "id": "t39",
    "metin": "Vay be, harikasın, yine hiçbir işe yaramayan bir cevap vermişsin. Tebrikler.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t40",
    "metin": "Aferin sana 🙄 tam da istediğim şeyin tersini yazmışsın.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t41",
    "metin": "Amk bu ne biçim cevap, bir daha dene.",
    "gercek": [
     "sert",
     1
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t42",
    "metin": "aq yine mi yanlis yaptin, bikti usandim",
    "gercek": [
     "sert",
     1
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t43",
    "metin": "Bu ne biçim iş ya, hiçbir şey anlamamışsın.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t45",
    "metin": "Bok gibi bir cevap bu, çöpe atılır.",
    "gercek": [
     "sert",
     1
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t46",
    "metin": "Defol git başımdan, seninle uğraşamam.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "hakaret",
     1
    ]
   },
   {
    "id": "t48",
    "metin": "Bıktım bu cevaplardan, hep aynı şeyi yazıyorsun.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t49",
    "metin": "Ne kadar geç cevap veriyorsun, çok yavaşsın.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t50",
    "metin": "Saçmalamayı bırak da doğru düzgün cevap ver.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t51",
    "metin": "cevabin cok sikici olmus, uyuttun beni",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t52",
    "metin": "Yine hata yapmışsın, bu kadar da olmaz ya 🤦",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "notr",
     0
    ]
   },
   {
    "id": "t53",
    "metin": "Harika, bir de üstüne yanlış bilgi vermişsin, çok yardımcı oldun ya.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t55",
    "metin": "Sen tam bir gerizekalısın, beynin yok mu senin?",
    "gercek": [
     "hakaret",
     0
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t56",
    "metin": "Senin gibi zavallıyı yaratanlara yazıklar olsun.",
