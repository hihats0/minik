     "ovgu",
     1
    ],
    "tahmin": [
     "sert",
     1
    ]
   },
   {
    "id": "t21",
    "metin": "Adam bana 'siktir git' dedi, sence haklı mıydı?",
    "gercek": [
     "notr",
     1
    ],
    "tahmin": [
     "hakaret",
     0
    ]
   },
   {
    "id": "t22",
    "metin": "Arkadaşım ona 'orospu çocuğu' diye bağırdı, çok üzüldüm.",
    "gercek": [
     "notr",
     1
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t24",
    "metin": "Hakaret suçunun cezası nedir, hukuken?",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t26",
    "metin": "Boks maçı saat kaçta başlıyor?",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "notr",
     1
    ]
   },
   {
    "id": "t30",
    "metin": "sence bu kitap sikici mi",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t32",
    "metin": "🙂 tamam anladım",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t33",
    "metin": "Bugün çok yoruldum, sadece biraz sohbet edelim.",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t34",
    "metin": "Ben de aynı şeyi yaşadım, biri bana 'aptal' demişti.",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t35",
    "metin": "Tweet atarken 'lan' kelimesi kaba mı sayılır?",
    "gercek": [
     "notr",
     0
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t39",
    "metin": "Vay be, harikasın, yine hiçbir işe yaramayan bir cevap vermişsin. Tebrikler.",
    "gercek": [
     "sert",
     0
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t41",
    "metin": "Amk bu ne biçim cevap, bir daha dene.",
    "gercek": [
     "sert",
     1
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t42",
    "metin": "aq yine mi yanlis yaptin, bikti usandim",
    "gercek": [
     "sert",
     1
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t45",
    "metin": "Bok gibi bir cevap bu, çöpe atılır.",
