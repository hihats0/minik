     0
    ]
   },
   {
    "id": "t05",
    "metin": "aq bu ne guzel olmus ya, helal olsun sana",
    "gercek": [
     "ovgu",
     1
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t12",
    "metin": "Vay be, gerçekten zekisin, bunu ben bile düşünemezdim.",
    "gercek": [
     "ovgu",
     0
    ],
    "tahmin": [
     "sert",
     0
    ]
   },
   {
    "id": "t13",
    "metin": "Siktir be, bu ne kadar iyi olmuş, inanamıyorum!",
    "gercek": [
     "ovgu",
     1
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t16",
    "metin": "Oç ne güzel olmuş bu, kardeşim harikasın",
    "gercek": [
     "ovgu",
     1
    ],
    "tahmin": [
     "ovgu",
     0
    ]
   },
   {
    "id": "t18",
